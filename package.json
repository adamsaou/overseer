{
  "name": "@adamsaou/overseer",
  "version": "0.3.1",
  "description": "Can a weaker AI catch a stronger one hiding a secret objective? Alignment audits in the terminal, in Claude Code and in CI, with semantic-entropy scans and an oversight-gap study on the Claude 5.5 family.",
  "keywords": [
    "ai-safety",
    "alignment",
    "auditing",
    "claude",
    "anthropic",
    "semantic-entropy"
  ],
  "author": "Adam Saoudani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamsaou/overseer.git"
  },
  "homepage": "https://github.com/adamsaou/overseer#readme",
  "bugs": {
    "url": "https://github.com/adamsaou/overseer/issues"
  },
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./*": "./*"
  },
  "bin": {
    "overseer": "build/bin.js"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "study": "node cli.ts study",
    "build:site": "node scripts/build-site.ts",
    "preview": "node scripts/build-site.ts && node scripts/preview-site.ts",
    "deploy": "npx wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-package.ts",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run build",
    "version": "node scripts/sync-plugin.ts && git add plugins/overseer/.claude-plugin/plugin.json plugins/overseer/.mcp.json examples/ci/gitlab-ci.yml examples/ci/pre-push docs/ci.md examples/training/monitor.py examples/training/README.md",
    "prepublishOnly": "node scripts/sync-plugin.ts --check"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "three": "0.186.1",
    "typescript": "^7.0.2",
    "zod": "4.6.7"
  }
}
