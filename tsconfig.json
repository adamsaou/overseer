{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true
  },
  "include": ["*.ts", "lib/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
  "exclude": ["worker.ts"]
}
