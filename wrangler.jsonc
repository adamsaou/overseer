{
  "name": "overseer",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // Showcase only: pages, saved replays and study results. See worker.ts for why live audits stay local.
  "build": { "command": "node scripts/build-site.ts" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
