{
  "name": "overseer",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // The site, with the saved replays and the study results as static JSON: the build bundles site/ into
  // dist/. The Worker only sends the retired web app's /app/ links to the site's replays.
  "build": { "command": "node scripts/build-site.ts" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/app", "/app/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
