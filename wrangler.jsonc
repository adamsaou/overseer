{
  "name": "overseer",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // Showcase only: the site, the app's saved replays and the study results. See worker.ts for why live
  // audits stay local. The build bundles site/ into dist/ with the data as static JSON.
  "build": { "command": "node scripts/build-site.ts" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
